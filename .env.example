# Copier ce fichier en ".env" et renseigner les valeurs. Ne JAMAIS commiter ".env".

# --- Base de donnees de l'application (PostgreSQL 15+) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mfish
SPRING_DATASOURCE_USERNAME=mfish
SPRING_DATASOURCE_PASSWORD=change-me

# --- Securite ---
# Secret HMAC des JWT : 32 caracteres minimum, aleatoire (ex: openssl rand -base64 48)
APP_JWT_SECRET=
# Hash BCrypt du mot de passe administrateur (ex: htpasswd -bnBC 10 "" 'motdepasse' | tr -d ':\n')
# ATTENTION : dans un fichier .env lu par Docker Compose, chaque "$" du hash doit etre double
# ("$$"). Sinon Compose interprete "$2b$12$xxxx" comme une variable ("$xxxx") non definie et
# tronque la valeur : la connexion echoue alors avec tous les mots de passe.
#   ex: APP_ADMIN_PASSWORD_HASH={bcrypt}$$2y$$10$$abcdef...
APP_ADMIN_PASSWORD_HASH=
# Origines autorisees pour le CORS (separees par des virgules)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Chatwoot ---
# URL vue par l'application (le conteneur Chatwoot reste sur localhost:3000).
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_WEBHOOK_SECRET=
# URL vue par le navigateur/téléphone : mettre l'IP LAN du PC pour tester depuis un téléphone.
CHATWOOT_FRONTEND_URL=http://localhost:3000

# --- Simulateur WhatsApp (test de bout en bout) ---
# Active l'interface /simulateur.
#   APP_SIMULATEUR_MODE=LOCAL    : webhook rejoue en local, reponses en memoire (sans Chatwoot)
#   APP_SIMULATEUR_MODE=CHATWOOT : messages via Chatwoot (conversation visible dans Chatwoot/telephone)
APP_SIMULATEUR_ACTIVE=false
APP_SIMULATEUR_MODE=LOCAL
# Identifiant de boite Chatwoot (inbox_identifier) requis en mode CHATWOOT.
APP_SIMULATEUR_INBOX=

# --- DeepSeek (IA) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- RouteXL (optimisation de tournee) ---
ROUTEXL_USERNAME=
ROUTEXL_PASSWORD=
ROUTEXL_MAX_STOPS=20

# --- Geocodage et fuseau horaire ---
GEOCODING_PROVIDER=nominatim
APP_TIMEZONE=Africa/Douala

# --- docker-compose : base de l'application ---
POSTGRES_DB=mfish
POSTGRES_USER=mfish
POSTGRES_PASSWORD=change-me

# --- Chatwoot (voir docs/CHATWOOT_SETUP.md) ---
# docker compose lit .env, pas .env.local : lancer Compose avec --env-file .env.local
# Genere avec: openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=
# URL vue par le navigateur/téléphone (IP LAN du PC pour tester depuis un téléphone)
CHATWOOT_FRONTEND_URL=http://localhost:3000
CHATWOOT_POSTGRES_PASSWORD=change-me
CHATWOOT_REDIS_PASSWORD=change-me

# --- WhatsApp Cloud API (Meta) ---
# Activer le module et renseigner les identifiants (voir docs/WHATSAPP_SETUP.md).
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_API_VERSION=v21.0

# --- Google Geocoding API ---
GOOGLE_GEOCODING_API=
